    private readonly AppDbContext _db;

    public EstadoGemeoStore(AppDbContext db)
    {
        _db = db;
    }

    public EstadoGemeoDigital Obter()
    {
        return ObterSnapshot();
    }

    public EstadoGemeoDigital ObterSnapshot()
    {
        GarantirEstadoInicial();

        var estadoId = _db.EstadosGemeoDigital
            .AsNoTracking()
            .OrderBy(x => x.AtualizadoEm)
            .Select(x => x.Id)
            .First();

        var estado = _db.EstadosGemeoDigital
            .AsNoTracking()
            .Where(x => x.Id == estadoId)
            .Include(x => x.Zonas)
            .Include(x => x.Sensores)
            .Include(x => x.Atuadores)
            .Include(x => x.Alertas.OrderByDescending(a => a.CriadoEm).Take(80))
            .Include(x => x.ProdutosOperacionais)
            .Include(x => x.LeiturasSensores.OrderByDescending(l => l.CriadoEm).Take(300))
            .Include(x => x.RotinasAutomaticas)
            .Include(x => x.ClientesSimulados.Where(c => c.Etapa != "Finalizado").OrderByDescending(c => c.CriadoEm).Take(20))
                .ThenInclude(x => x.Itens)
            .Include(x => x.RelatorioGerencial)
                .ThenInclude(x => x!.RecomendacoesCompra)
            .Include(x => x.LinhaDoTempo.OrderByDescending(e => e.CriadoEm).Take(150))
            .AsSplitQuery()
            .First();

        estado.Zonas = estado.Zonas.OrderBy(x => x.Nome).ToList();
        estado.Sensores = estado.Sensores.OrderBy(x => x.Nome).ToList();
        estado.Atuadores = estado.Atuadores.OrderBy(x => x.Nome).ToList();
        estado.ProdutosOperacionais = estado.ProdutosOperacionais.OrderBy(x => x.Categoria).ThenBy(x => x.Nome).ToList();
        estado.RotinasAutomaticas = estado.RotinasAutomaticas.OrderBy(x => x.Nome).ToList();
        estado.LeiturasSensores = estado.LeiturasSensores.OrderByDescending(x => x.CriadoEm).ToList();
        estado.LinhaDoTempo = estado.LinhaDoTempo.OrderByDescending(x => x.CriadoEm).ToList();
        estado.Alertas = estado.Alertas.OrderByDescending(x => x.CriadoEm).ToList();

        return estado;
    }

    public Guid ObterEstadoId()
    {
        GarantirEstadoInicial();
        return _db.EstadosGemeoDigital.AsNoTracking().OrderBy(x => x.AtualizadoEm).Select(x => x.Id).First();
    }

    public EstadoGemeoDigital Reiniciar()
    {
        var estados = _db.EstadosGemeoDigital.ToList();
        _db.EstadosGemeoDigital.RemoveRange(estados);
        _db.SaveChanges();

        var novoEstado = CriarEstadoInicial();
        _db.EstadosGemeoDigital.Add(novoEstado);
        _db.SaveChanges();

        return ObterSnapshot();
    }

    public void Salvar()
    {
        _db.SaveChanges();
    }

    private void GarantirEstadoInicial()
    {
        if (_db.EstadosGemeoDigital.AsNoTracking().Any())
            return;

        var novoEstado = CriarEstadoInicial();
        _db.EstadosGemeoDigital.Add(novoEstado);
        _db.SaveChanges();
    }

