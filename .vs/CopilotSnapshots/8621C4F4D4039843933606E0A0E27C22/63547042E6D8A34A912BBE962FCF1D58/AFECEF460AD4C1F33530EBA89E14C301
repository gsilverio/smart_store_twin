    private static List<LeituraSensorHistorico> CriarHistoricoLeiturasSensores(EstadoGemeoDigital estado)
    {
        var leituras = new List<LeituraSensorHistorico>();
        var inicio = DateTime.UtcNow.AddHours(-8);

        for (var i = 0; i < 32; i++)
        {
            var horario = inicio.AddMinutes(i * 15);
            var ciclo = i % 12;
            var pessoas = ciclo switch
            {
                <= 2 => 1 + ciclo,
                <= 5 => 5 + ciclo,
                <= 8 => 9 + (ciclo - 5),
                _ => 3
            };

            foreach (var sensor in estado.Sensores)
            {
                var zona = estado.Zonas.First(x => x.Id == sensor.ZonaId);
                var valor = sensor.Tipo switch
                {
                    TipoSensor.Presenca => pessoas,
                    TipoSensor.Temperatura => 4 + (i % 7 == 0 ? 2.2m : i % 11 == 0 ? 3.5m : 0.4m),
                    TipoSensor.Energia => pessoas <= 2 ? 3.9m : pessoas >= 9 ? 7.9m : 5.2m,
                    TipoSensor.PesoPrateleira when zona.Nome.Contains("Bebidas") => Math.Max(30, 72 - i),
                    TipoSensor.PesoPrateleira when zona.Nome.Contains("Snacks") => Math.Max(26, 63 - (i / 2)),
                    TipoSensor.Checkout => pessoas >= 8 ? 1 : 0,
                    TipoSensor.Porta => 1,
                    _ => 0
                };

                leituras.Add(new LeituraSensorHistorico
                {
                    SensorId = sensor.Id,
                    SensorNome = sensor.Nome,
                    TipoSensor = sensor.Tipo,
                    ZonaId = zona.Id,
                    ZonaNome = zona.Nome,
                    Valor = valor,
                    Unidade = ObterUnidadeSensor(sensor.Tipo),
                    Observacao = "Seed historico: comportamento das ultimas 8 horas para apoiar as rotinas do gemeo digital.",
                    CriadoEm = horario
                });
            }
        }

        return leituras.OrderByDescending(x => x.CriadoEm).ToList();
    }

    private static void AplicarHistoricoComoBaseDeDecisao(EstadoGemeoDigital estado)
    {
        var leiturasRecentes = estado.LeiturasSensores
            .Where(x => x.CriadoEm >= DateTime.UtcNow.AddHours(-2))
            .ToList();

        var mediaEnergia = leiturasRecentes
            .Where(x => x.TipoSensor == TipoSensor.Energia)
            .Select(x => x.Valor)
            .DefaultIfEmpty(estado.ConsumoEnergiaTotalKwh)
            .Average();

        var mediaFluxo = leiturasRecentes
            .Where(x => x.TipoSensor == TipoSensor.Presenca)
            .Select(x => x.Valor)
            .DefaultIfEmpty(estado.PessoasNaLoja)
            .Average();

        estado.ConsumoEnergiaTotalKwh = Math.Round(mediaEnergia, 2);
        estado.PessoasNaLoja = (int)Math.Round(mediaFluxo);
        estado.ReceitaEstimadaHoje = estado.ProdutosOperacionais.Sum(x => x.ReceitaHoje);
        estado.ProdutosVendidosHoje = estado.ProdutosOperacionais.Sum(x => x.VendidosHoje);
        estado.CustoEnergiaEstimadoHoje = Math.Round(estado.ConsumoEnergiaTotalKwh * 0.92m, 2);
    }

    private static string ObterUnidadeSensor(TipoSensor tipo)
    {
        return tipo switch
        {
            TipoSensor.Presenca => "pessoas",
            TipoSensor.Temperatura => "°C",
            TipoSensor.Energia => "kWh",
            TipoSensor.PesoPrateleira => "un.",
            TipoSensor.Checkout => "status",
            TipoSensor.Porta => "status",
            _ => "valor"
        };
    }
