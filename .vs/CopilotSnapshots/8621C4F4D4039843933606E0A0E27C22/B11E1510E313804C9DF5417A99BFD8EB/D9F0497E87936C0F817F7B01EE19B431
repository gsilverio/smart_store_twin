    private void CriarAlerta(Guid estadoId, string titulo, string descricao, SeveridadeAlerta severidade, Guid? zonaId, string recomendacao, decimal impacto)
    {
        var existe = _db.AlertasLoja.Any(a => a.EstadoGemeoDigitalId == estadoId && a.Titulo == titulo && a.Status == StatusAlerta.Aberto);
        if (existe) return;

        _db.AlertasLoja.Add(new AlertaLoja
        {
            EstadoGemeoDigitalId = estadoId,
            Titulo = titulo,
            Descricao = descricao,
            Severidade = severidade,
            ZonaId = zonaId,
            Recomendacao = recomendacao,
            ImpactoFinanceiroEstimado = impacto,
            CriadoEm = DateTime.UtcNow
        });

        AdicionarEvento(estadoId, TipoEventoLinhaDoTempo.AlertaCriado, $"Alerta criado: {titulo}. Severidade: {severidade}.", "Motor de regras");
        AdicionarEvento(estadoId, TipoEventoLinhaDoTempo.RecomendacaoGerada, $"Recomendacao gerada: {recomendacao}", "Motor de regras");
    }

    private void AplicarLeitura(EstadoGemeoDigital estado, SensorLoja sensor, ZonaLoja zona, decimal valor)
    {
        switch (sensor.Tipo)
        {
            case TipoSensor.Presenca:
                estado.PessoasNaLoja = Math.Max(0, (int)valor);
                zona.QuantidadePessoas = estado.PessoasNaLoja;
                if (estado.PessoasNaLoja > estado.CapacidadeRecomendada)
                    CriarAlerta(estado.Id, "Lotacao acima do recomendado", "A leitura do sensor de presenca indicou excesso de pessoas na loja.", SeveridadeAlerta.Alta, zona.Id, "Limitar entrada temporariamente.", 0);
                break;
            case TipoSensor.Temperatura:
                zona.TemperaturaCelsius = valor;
                if (valor >= 10)
                {
                    zona.Status = StatusZona.Critico;
                    zona.RiscoAtual = "Temperatura critica para produtos pereciveis.";
                    estado.PerdaFinanceiraEstimada += 240;
                    CriarAlerta(estado.Id, "Temperatura critica na geladeira", "A leitura do sensor de temperatura ultrapassou o limite seguro.", SeveridadeAlerta.Critica, zona.Id, "Ativar refrigeracao maxima e verificar equipamento.", 240);
                }
                break;
            case TipoSensor.Energia:
                estado.ConsumoEnergiaTotalKwh = valor;
                zona.ConsumoEnergiaKwh = valor;
                if (valor > 8)
                    CriarAlerta(estado.Id, "Consumo energetico anormal", "O sensor de energia detectou consumo acima do comportamento esperado.", SeveridadeAlerta.Media, zona.Id, "Ativar modo economico e verificar equipamentos.", 35);
                break;
            case TipoSensor.PesoPrateleira:
                zona.EstoqueFisico = Math.Max(0, (int)valor);
                if (zona.EstoqueFisico <= 6)
                    CriarAlerta(estado.Id, $"Estoque critico em {zona.Nome}", "A leitura do sensor de peso indicou estoque abaixo do nivel recomendado.", SeveridadeAlerta.Media, zona.Id, "Realizar reposicao da prateleira.", 0);
                break;
            case TipoSensor.Checkout:
                zona.Status = valor >= 2 ? StatusZona.Manutencao : valor == 1 ? StatusZona.Atencao : StatusZona.Normal;
                if (valor >= 2)
                    CriarAlerta(estado.Id, "Checkout fora do ar", "O sensor do checkout indicou falha no terminal de autoatendimento.", SeveridadeAlerta.Alta, zona.Id, "Colocar checkout em manutencao e limitar entrada temporariamente.", 80);
                break;
            case TipoSensor.Porta:
                zona.Status = valor >= 2 ? StatusZona.Bloqueado : StatusZona.Normal;
                break;
        }

        zona.AtualizadoEm = DateTime.UtcNow;
        sensor.UltimaLeituraEm = DateTime.UtcNow;
    }

    private void AplicarAcaoAtuador(Guid estadoId, AtuadorLoja atuador, string acao)
    {
        atuador.Status = acao;
        atuador.UltimaAcao = acao;
        atuador.UltimaAcaoEm = DateTime.UtcNow;

        var zona = _db.ZonasLoja.FirstOrDefault(x => x.EstadoGemeoDigitalId == estadoId && x.Id == atuador.ZonaId);
        if (zona is null) return;

        if (atuador.Tipo == TipoAtuador.PortaAutomatica)
        {
            zona.Status = acao.Contains("bloque", StringComparison.OrdinalIgnoreCase) ? StatusZona.Bloqueado : acao.Contains("limit", StringComparison.OrdinalIgnoreCase) ? StatusZona.Atencao : StatusZona.Normal;
            zona.RiscoAtual = zona.Status == StatusZona.Normal ? null : $"Porta automatica em estado: {acao}.";
        }
        else if (atuador.Tipo == TipoAtuador.Refrigeracao)
        {
            zona.TemperaturaCelsius = acao.Contains("maxima", StringComparison.OrdinalIgnoreCase) ? Math.Max(4, (zona.TemperaturaCelsius ?? 10) - 3) : zona.TemperaturaCelsius;
            zona.Status = acao.Contains("economico", StringComparison.OrdinalIgnoreCase) ? StatusZona.ModoEconomico : acao.Contains("maxima", StringComparison.OrdinalIgnoreCase) ? StatusZona.Atencao : StatusZona.Normal;
            zona.RiscoAtual = acao;
        }
        else if (atuador.Tipo == TipoAtuador.Iluminacao)
        {
            zona.Status = acao.Contains("economico", StringComparison.OrdinalIgnoreCase) ? StatusZona.ModoEconomico : acao.Contains("alerta", StringComparison.OrdinalIgnoreCase) ? StatusZona.Atencao : StatusZona.Normal;
            zona.RiscoAtual = zona.Status == StatusZona.Normal ? null : acao;
        }
        else if (atuador.Tipo == TipoAtuador.Checkout)
        {
            zona.Status = acao.Contains("manutencao", StringComparison.OrdinalIgnoreCase) ? StatusZona.Manutencao : acao.Contains("reiniciar", StringComparison.OrdinalIgnoreCase) ? StatusZona.Atencao : StatusZona.Normal;
            zona.RiscoAtual = zona.Status == StatusZona.Normal ? null : acao;
        }
        else if (atuador.Tipo == TipoAtuador.PainelDigital)
        {
            zona.Status = acao.Contains("padrao", StringComparison.OrdinalIgnoreCase) ? StatusZona.Normal : StatusZona.Atencao;
            zona.RiscoAtual = zona.Status == StatusZona.Normal ? null : acao;
        }

        zona.AtualizadoEm = DateTime.UtcNow;
    }

    private void AplicarCenarioHorarioPico(EstadoGemeoDigital estado, List<ZonaLoja> zonas, List<AtuadorLoja> atuadores, List<SensorLoja> sensores)
    {
        estado.PessoasNaLoja = 18;
        var entrada = zonas.FirstOrDefault(x => x.Tipo == TipoZona.Entrada);
        var circulacao = zonas.FirstOrDefault(x => x.Tipo == TipoZona.Circulacao);
        var checkout = zonas.FirstOrDefault(x => x.Tipo == TipoZona.Checkout);
        if (entrada is not null) { entrada.Status = StatusZona.Atencao; entrada.RiscoAtual = "Entrada deve ser limitada temporariamente."; }
        if (circulacao is not null) { circulacao.Status = StatusZona.Atencao; circulacao.QuantidadePessoas = 18; }
        if (checkout is not null) { checkout.Status = StatusZona.Atencao; checkout.RiscoAtual = "Possivel formacao de fila."; }
        CriarAlerta(estado.Id, "Lotacao acima do recomendado", "A quantidade de clientes ultrapassou a capacidade recomendada.", SeveridadeAlerta.Alta, entrada?.Id, "Limitar entrada e ativar checkout secundario.", 0);
        var porta = atuadores.FirstOrDefault(x => x.Tipo == TipoAtuador.PortaAutomatica); if (porta is not null) AplicarAcaoAtuador(estado.Id, porta, "Entrada limitada");
    }

    private void AplicarCenarioFalhaGeladeira(EstadoGemeoDigital estado, List<ZonaLoja> zonas, List<AtuadorLoja> atuadores, List<SensorLoja> sensores)
    {
        var geladeira = zonas.FirstOrDefault(x => x.Tipo == TipoZona.Geladeira);
        if (geladeira is null) return;
        geladeira.TemperaturaCelsius = 12;
        geladeira.ConsumoEnergiaKwh = 4.9m;
        geladeira.Status = StatusZona.Critico;
        geladeira.RiscoAtual = "Risco de perda de produtos pereciveis.";
        estado.PerdaFinanceiraEstimada += 240;
        CriarAlerta(estado.Id, "Temperatura critica na geladeira", "Temperatura ultrapassou o limite seguro para pereciveis.", SeveridadeAlerta.Critica, geladeira.Id, "Ativar refrigeracao maxima e verificar equipamento.", 240);
        var refri = atuadores.FirstOrDefault(x => x.Tipo == TipoAtuador.Refrigeracao); if (refri is not null) AplicarAcaoAtuador(estado.Id, refri, "Refrigeracao maxima");
        var sensor = sensores.FirstOrDefault(x => x.Tipo == TipoSensor.Temperatura); if (sensor is not null) RegistrarHistoricoLeitura(estado.Id, sensor, geladeira, 12, "Cenario de falha da geladeira");
    }

    private void AplicarCenarioCheckoutForaDoAr(EstadoGemeoDigital estado, List<ZonaLoja> zonas, List<AtuadorLoja> atuadores, List<SensorLoja> sensores)
    {
        var checkout = zonas.FirstOrDefault(x => x.Tipo == TipoZona.Checkout);
        if (checkout is null) return;
        checkout.Status = StatusZona.Manutencao;
        checkout.RiscoAtual = "Checkout indisponivel para pagamentos.";
        estado.PerdaFinanceiraEstimada += 80;
        CriarAlerta(estado.Id, "Checkout fora do ar", "Terminal de autoatendimento apresentou falha operacional.", SeveridadeAlerta.Alta, checkout.Id, "Colocar checkout em manutencao e limitar entrada.", 80);
        var at = atuadores.FirstOrDefault(x => x.Tipo == TipoAtuador.Checkout); if (at is not null) AplicarAcaoAtuador(estado.Id, at, "Modo manutencao");
    }

    private void AplicarCenarioDivergenciaPagamento(EstadoGemeoDigital estado, List<ZonaLoja> zonas, List<ProdutoOperacional> produtos, List<AtuadorLoja> atuadores, List<SensorLoja> sensores)
    {
        var bebidas = BuscarZonaPorNome(zonas, "Bebidas");
        if (bebidas is not null)
        {
            bebidas.Status = StatusZona.Critico;
            bebidas.EstoqueFisico = Math.Max(0, (bebidas.EstoqueFisico ?? 0) - 2);
            bebidas.RiscoAtual = "Divergencia entre estoque esperado e fisico.";
        }
        var produto = produtos.FirstOrDefault(x => x.Categoria == "Bebidas");
        if (produto is not null)
        {
            produto.PerdidosHoje += 2;
            produto.EstoqueAtual = Math.Max(0, produto.EstoqueAtual - 2);
            estado.PerdaFinanceiraEstimada += produto.PrecoVenda * 2;
        }
        CriarAlerta(estado.Id, "Divergencia entre retirada e pagamento", "Sensor indicou retirada maior que pagamento registrado.", SeveridadeAlerta.Critica, bebidas?.Id, "Revisar eventos do checkout e conferir estoque fisico.", produto?.PrecoVenda * 2 ?? 18.5m);
    }

    private void AplicarCenarioPicoEnergia(EstadoGemeoDigital estado, List<ZonaLoja> zonas, List<AtuadorLoja> atuadores, List<SensorLoja> sensores)
    {
        estado.ConsumoEnergiaTotalKwh = 9.8m;
        estado.CustoEnergiaEstimadoHoje = 9.8m * 0.92m;
        var circulacao = zonas.FirstOrDefault(x => x.Tipo == TipoZona.Circulacao);
        if (circulacao is not null) { circulacao.Status = StatusZona.Atencao; circulacao.ConsumoEnergiaKwh = 9.8m; circulacao.RiscoAtual = "Consumo energetico acima do padrao."; }
        CriarAlerta(estado.Id, "Consumo energetico anormal", "Consumo da loja esta acima do comportamento esperado.", SeveridadeAlerta.Media, circulacao?.Id, "Ativar modo economico e verificar equipamentos.", 35);
        var luz = atuadores.FirstOrDefault(x => x.Tipo == TipoAtuador.Iluminacao); if (luz is not null) AplicarAcaoAtuador(estado.Id, luz, "Modo economico");
    }

    private void AplicarCenarioEstoqueCritico(EstadoGemeoDigital estado, List<ZonaLoja> zonas, List<ProdutoOperacional> produtos, List<AtuadorLoja> atuadores, List<SensorLoja> sensores)
    {
        var bebidas = BuscarZonaPorNome(zonas, "Bebidas");
        foreach (var p in produtos.Where(x => x.Categoria == "Bebidas"))
        {
            p.EstoqueAtual = Math.Min(p.EstoqueAtual, 5);
            p.AtualizadoEm = DateTime.UtcNow;
        }
        if (bebidas is not null) { bebidas.EstoqueFisico = produtos.Where(p => p.Categoria == "Bebidas").Sum(p => p.EstoqueAtual); bebidas.Status = StatusZona.Atencao; bebidas.RiscoAtual = "Estoque abaixo do minimo operacional."; }
        CriarAlerta(estado.Id, "Estoque critico de bebidas", "Prateleira de bebidas esta abaixo do nivel recomendado.", SeveridadeAlerta.Media, bebidas?.Id, "Repor bebidas antes do proximo pico de fluxo.", 0);
    }

    // Tenta salvar com politica de retentativa e merge simples para conflitos de concorrencia otimista
    private void SalvarComRetentativas(int maxAttempts = 3)
    {
        for (int attempt = 1; attempt <= maxAttempts; attempt++)
        {
            try
            {
                _db.SaveChanges();
                return;
            }
            catch (DbUpdateConcurrencyException ex) when (attempt < maxAttempts)
            {
                foreach (var entry in ex.Entries.ToList())
                {
                    var dbValues = entry.GetDatabaseValues();
                    if (dbValues == null)
                    {
                        // Registro foi removido no DB - desanexa a entidade local
                        entry.State = EntityState.Detached;
                        continue;
                    }

                    // Captura valores originais carregados para cálculo de delta
                    var origValues = new Dictionary<string, object?>();
                    foreach (var p in entry.OriginalValues.Properties)
                        origValues[p.Name] = entry.OriginalValues[p.Name];

                    // Valores do DB atuais
                    var dbValsLookup = new Dictionary<string, object?>();
                    foreach (var p in dbValues.Properties)
                        dbValsLookup[p.Name] = dbValues[p.Name];

                    // Define OriginalValues para o estado atual do DB
                    entry.OriginalValues.SetValues(dbValues);

                    // Para cada propriedade, aplica politica de merge simples
                    foreach (var prop in entry.CurrentValues.Properties)
                    {
                        var name = prop.Name;
                        var orig = origValues.ContainsKey(name) ? origValues[name] : null;
                        var curr = entry.CurrentValues[name];
                        var dbVal = dbValsLookup.ContainsKey(name) ? dbValsLookup[name] : null;

                        object? merged = curr ?? dbVal;

                        if (orig != null && curr != null && dbVal != null)
                        {
                            var type = prop.ClrType;
                            if (type == typeof(int) || type == typeof(long) || type == typeof(decimal) || type == typeof(double) || type == typeof(float))
                            {
                                try
                                {
                                    var o = Convert.ToDecimal(orig);
                                    var c = Convert.ToDecimal(curr);
                                    var d = Convert.ToDecimal(dbVal);
                                    var result = d + (c - o);
                                    merged = Convert.ChangeType(result, type);
                                }
                                catch
                                {
                                    merged = curr;
                                }
                            }
                            else
                            {
                                // client wins para valores nao numericos
                                merged = curr;
                            }
                        }

                        try
                        {
                            entry.CurrentValues[name] = merged;
                        }
                        catch
                        {
                            // se nao for possivel atribuir, ignorar e deixar valor do cliente
                            entry.CurrentValues[name] = entry.CurrentValues[name];
                        }
                    }
                }

                // tentar novamente
                continue;
            }
        }

        throw new DbUpdateConcurrencyException("Falha ao persistir alterações após múltiplas tentativas devido a conflitos de concorrência.");
    }
